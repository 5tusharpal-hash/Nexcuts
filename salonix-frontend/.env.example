# Public browser configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_REQUEST_TIMEOUT_MS=15000

# Server configuration
AUTH_COOKIE_NAME=salonix_refresh_token
# Must match the backend. The refresh cookie stays host-only on the API host;
# protected pages validate the session through the backend instead.

# Production example
# NEXT_PUBLIC_APP_URL=https://app.salonix.com
# NEXT_PUBLIC_API_URL=https://api.salonix.com/api/v1
