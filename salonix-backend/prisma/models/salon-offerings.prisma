  isEligible Boolean @default(true) @map("is_eligible")

  @@id([salonId, category])
  @@map("salon_loyalty_eligible_categories")
}

model CustomerLoyaltyLedger {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerAccountId    String   @map("customer_account_id") @db.Uuid
  salonId              String   @map("salon_id") @db.Uuid
  amount               Decimal  @db.Decimal(12, 2)
  transactionReference String?  @map("transaction_reference") @db.Uuid
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz(6)
  entryType            String   @default("EARNED") @map("entry_type") @db.VarChar(20)
  idempotencyKey       String?  @map("idempotency_key") @db.VarChar(255)
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([salonId, idempotencyKey])
  @@index([customerAccountId, salonId, expiresAt])
  @@map("customer_loyalty_ledger")
}

model CustomerLoyaltyLotAllocation {
