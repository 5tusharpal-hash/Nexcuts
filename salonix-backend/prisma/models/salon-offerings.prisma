model SalonLoyaltyProgram {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId             String   @unique @map("salon_id") @db.Uuid
  minimumSpend        Decimal  @default(0) @map("minimum_spend") @db.Decimal(12, 2)
  rewardPercentage    Decimal  @default(0) @map("reward_percentage") @db.Decimal(5, 2)
  pointConversionRate Decimal  @default(1) @map("point_conversion_rate") @db.Decimal(8, 4)
  pointsExpiryDays    Int      @default(365) @map("points_expiry_days")
  isActive            Boolean  @default(true) @map("is_active")
  closedAt            DateTime? @map("closed_at") @db.Timestamptz(6)
  redeemUntil         DateTime? @map("redeem_until") @db.Timestamptz(6)
  expiryLockedAt      DateTime? @map("expiry_locked_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@map("salon_loyalty_programs")
}

