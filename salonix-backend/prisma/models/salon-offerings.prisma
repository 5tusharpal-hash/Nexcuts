model SalonPackage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId      String   @map("salon_id") @db.Uuid
  name         String   @db.VarChar(255)
  description  String?
  sellingPrice Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  totalValue   Decimal  @map("total_value") @db.Decimal(12, 2)
  validityDays Int      @map("validity_days")
  status       String   @default("DRAFT") @db.VarChar(20)
  currentRevisionId String? @map("current_revision_id") @db.Uuid
  isPublic     Boolean  @default(true) @map("is_public")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@map("salon_packages")
}

model SalonPackageService {
  packageId String @map("package_id") @db.Uuid
  salonId   String @map("salon_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  maxUses   Int?   @map("max_uses")

  @@id([packageId, serviceId])
  @@map("salon_package_services")
}

model SalonServiceCombo {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId     String   @map("salon_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  bundlePrice Decimal  @map("bundle_price") @db.Decimal(12, 2)
  validityDays Int    @default(7) @map("validity_days")
  status      String   @default("DRAFT") @db.VarChar(20)
  currentRevisionId String? @map("current_revision_id") @db.Uuid
  isPublic    Boolean  @default(true) @map("is_public")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@map("salon_service_combos")
}

model SalonComboService {
  comboId   String @map("combo_id") @db.Uuid
  salonId   String @map("salon_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  @@id([comboId, serviceId])
  @@map("salon_combo_services")
}

model CustomerPackageSubscription {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerAccountId String    @map("customer_account_id") @db.Uuid
  salonId           String    @map("salon_id") @db.Uuid
  packageId         String?   @map("package_id") @db.Uuid
  purchaseRequestId String?   @unique @map("purchase_request_id") @db.Uuid
  customName        String?   @map("custom_name") @db.VarChar(255)
  customValue       Decimal?  @map("custom_value") @db.Decimal(12, 2)
  sellingPrice      Decimal?  @map("selling_price") @db.Decimal(12, 2)
  termsSnapshot     Json?     @map("terms_snapshot")
  startsAt          DateTime  @map("starts_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  remainingValue    Decimal?  @map("remaining_value") @db.Decimal(12, 2)
  paymentStatus     String    @default("PENDING") @map("payment_status") @db.VarChar(20)
  status            String    @default("ACTIVE") @db.VarChar(20)
  isManualAssignment Boolean  @default(false) @map("is_manual_assignment")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@index([customerAccountId, salonId, expiresAt])
  @@map("customer_package_subscriptions")
}

model CustomerPackageServiceBalance {
  subscriptionId String  @map("subscription_id") @db.Uuid
  salonId         String  @map("salon_id") @db.Uuid
  serviceId       String  @map("service_id") @db.Uuid
  maxUses         Int?    @map("max_uses")
  usedCount       Int     @default(0) @map("used_count")

  @@id([subscriptionId, serviceId])
  @@map("customer_package_service_balances")
}

model CustomerComboPurchase {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerAccountId String   @map("customer_account_id") @db.Uuid
  salonId           String   @map("salon_id") @db.Uuid
  comboId           String   @map("combo_id") @db.Uuid
  purchaseRequestId String?  @unique @map("purchase_request_id") @db.Uuid
  sellingPrice      Decimal? @map("selling_price") @db.Decimal(12, 2)
  termsSnapshot     Json?    @map("terms_snapshot")
  purchasedAt       DateTime @default(now()) @map("purchased_at") @db.Timestamptz(6)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  paymentStatus     String   @default("PENDING") @map("payment_status") @db.VarChar(20)
  status            String   @default("ACTIVE") @db.VarChar(20)
  isManualAssignment Boolean @default(false) @map("is_manual_assignment")

  @@map("customer_combo_purchases")
}

model SalonOfferPurchaseRequest {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId            String   @map("salon_id") @db.Uuid
  customerAccountId  String   @map("customer_account_id") @db.Uuid
  offerType          String   @map("offer_type") @db.VarChar(20)
  packageId          String?  @map("package_id") @db.Uuid
  comboId            String?  @map("combo_id") @db.Uuid
  packageRevisionId  String?  @map("package_revision_id") @db.Uuid
  comboRevisionId    String?  @map("combo_revision_id") @db.Uuid
  status             String   @default("PENDING") @db.VarChar(20)
  paymentMode        String?  @map("payment_mode") @db.VarChar(20)
  listPrice          Decimal  @map("list_price") @db.Decimal(12, 2)
  finalAmount        Decimal  @map("final_amount") @db.Decimal(12, 2)
  discountAmount     Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason     String?  @map("discount_reason")
  termsSnapshot      Json     @map("terms_snapshot")
  servicesSnapshot   Json     @map("services_snapshot")
  isManualAssignment Boolean  @default(false) @map("is_manual_assignment")
  createdByAccountId String   @map("created_by_account_id") @db.Uuid
  billId             String?  @map("bill_id") @db.Uuid
  idempotencyKey     String?  @map("idempotency_key") @db.VarChar(255)
  rejectedByAccountId String? @map("rejected_by_account_id") @db.Uuid
  rejectionReason   String?   @map("rejection_reason")
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@unique([createdByAccountId, idempotencyKey])
  @@index([salonId, status, createdAt])
  @@index([customerAccountId, createdAt])
  @@map("salon_offer_purchase_requests")
}

model SalonOfferLedgerEntry {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId            String   @map("salon_id") @db.Uuid
  customerAccountId  String   @map("customer_account_id") @db.Uuid
  purchaseRequestId  String   @map("purchase_request_id") @db.Uuid
  entryType          String   @map("entry_type") @db.VarChar(20)
  amount             Decimal  @default(0) @db.Decimal(12, 2)
  serviceId          String?  @map("service_id") @db.Uuid
  billId             String?  @map("bill_id") @db.Uuid
  idempotencyKey     String?  @map("idempotency_key") @db.VarChar(255)
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([salonId, idempotencyKey])
  @@index([customerAccountId, salonId, createdAt])
  @@index([purchaseRequestId, createdAt])
  @@map("salon_offer_ledger")
}

