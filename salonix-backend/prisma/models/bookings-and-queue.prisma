model BookingGroup {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId             String   @map("salon_id") @db.Uuid
  coordinatorAccountId String @map("coordinator_account_id") @db.Uuid
  groupName           String?  @map("group_name") @db.VarChar(120)
  status              String   @default("ACTIVE") @db.VarChar(20)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@map("booking_groups")
}

model CustomerBooking {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerAccountId        String    @map("customer_account_id") @db.Uuid
  salonId                  String    @map("salon_id") @db.Uuid
  groupId                  String?   @map("group_id") @db.Uuid
  appointmentDate          DateTime  @map("appointment_date") @db.Date
  appointmentAt            DateTime  @map("appointment_at") @db.Timestamptz(6)
  estimatedDurationMinutes Int       @map("estimated_duration_minutes")
  bookingType              String    @default("APPOINTMENT") @map("booking_type") @db.VarChar(20)
  status                   String    @default("PENDING") @db.VarChar(20)
  notes                    String?
  isCoordinator            Boolean   @default(false) @map("is_coordinator")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@unique([id, salonId, customerAccountId])
  @@index([salonId, appointmentDate, status])
  @@map("customer_bookings")
}

model CustomerBookingService {
  bookingId       String   @map("booking_id") @db.Uuid
  salonId         String   @map("salon_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  durationMinutes Int      @map("duration_minutes")
  priceAtBooking  Decimal  @map("price_at_booking") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([bookingId, serviceId])
  @@map("customer_booking_services")
}

model CustomerBookingStaff {
  bookingId        String   @map("booking_id") @db.Uuid
  salonId          String   @map("salon_id") @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  membershipId     String   @map("membership_id") @db.Uuid
  status           String   @default("ASSIGNED") @db.VarChar(20)
  assignedByAccountId String? @map("assigned_by_account_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([bookingId, serviceId, membershipId])
  @@map("customer_booking_staff")
}

model QueueEntry {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId                  String    @map("salon_id") @db.Uuid
  customerAccountId        String    @map("customer_account_id") @db.Uuid
  bookingId                String?   @unique @map("booking_id") @db.Uuid
  entryType                String    @map("entry_type") @db.VarChar(20)
  preferredTime            DateTime? @map("preferred_time") @db.Timestamptz(6)
  estimatedDurationMinutes Int       @map("estimated_duration_minutes")
  arrivalTime              DateTime? @map("arrival_time") @db.Timestamptz(6)
  actualStartTime          DateTime? @map("actual_start_time") @db.Timestamptz(6)
  actualEndTime            DateTime? @map("actual_end_time") @db.Timestamptz(6)
  priority                 Int       @default(0) @db.SmallInt
  position                 Int
  status                   String    @default("WAITING") @db.VarChar(20)
  customerChoiceStylist    Boolean   @default(false) @map("customer_choice_stylist")
  scheduledStartAt         DateTime? @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt           DateTime? @map("scheduled_end_at") @db.Timestamptz(6)
  scheduleVersion          Int       @default(0) @map("schedule_version")
  manualOverrideReason     String?   @map("manual_override_reason")
  ownerApprovedAfterHours  Boolean   @default(false) @map("owner_approved_after_hours")
  ownerApprovalExpiresAt   DateTime? @map("owner_approval_expires_at") @db.Timestamptz(6)
  lastRecalculatedAt       DateTime? @map("last_recalculated_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@index([salonId, status, priority, position])
  @@map("queue_entries")
}

model QueueEntryService {
  entryId       String @map("entry_id") @db.Uuid
  salonId       String @map("salon_id") @db.Uuid
  serviceId     String @map("service_id") @db.Uuid
  durationMinutes Int @map("duration_minutes")

  @@id([entryId, serviceId])
  @@map("queue_entry_services")
}

model QueueEntryStaff {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId       String    @map("entry_id") @db.Uuid
  salonId       String    @map("salon_id") @db.Uuid
  membershipId  String    @map("membership_id") @db.Uuid
  serviceId     String    @map("service_id") @db.Uuid
  plannedStart  DateTime? @map("planned_start") @db.Timestamptz(6)
  plannedEnd    DateTime? @map("planned_end") @db.Timestamptz(6)
  actualStart   DateTime? @map("actual_start") @db.Timestamptz(6)
  actualEnd     DateTime? @map("actual_end") @db.Timestamptz(6)
  status        String    @default("SCHEDULED") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@map("queue_entry_staff")
}

model StylistState {
  salonId                String    @map("salon_id") @db.Uuid
  membershipId           String    @map("membership_id") @db.Uuid
  currentStatus          String    @default("AVAILABLE") @map("current_status") @db.VarChar(24)
  currentEntryId         String?   @map("current_entry_id") @db.Uuid
  nextBreakStart         DateTime? @map("next_break_start") @db.Timestamptz(6)
  breakDurationMinutes   Int?      @map("break_duration_minutes")
  preferredBreakWindow   String?   @map("preferred_break_window") @db.VarChar(30)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([salonId, membershipId])
  @@map("stylist_states")
}

model SalonBreakLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId      String    @map("salon_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  originalStart DateTime? @map("original_start") @db.Timestamptz(6)
  actualStart  DateTime? @map("actual_start") @db.Timestamptz(6)
  shiftReason  String?   @map("shift_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("salon_break_logs")
}

model QueueClosingRequest {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId             String   @map("salon_id") @db.Uuid
  entryId             String   @map("entry_id") @db.Uuid
  requestedStartAt    DateTime @map("requested_start_at") @db.Timestamptz(6)
  requestedEndAt      DateTime @map("requested_end_at") @db.Timestamptz(6)
  status              String   @default("PENDING") @db.VarChar(20)
  requestedByAccountId String  @map("requested_by_account_id") @db.Uuid
  reviewedByAccountId String?  @map("reviewed_by_account_id") @db.Uuid
  reviewNote          String?
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([entryId])
  @@index([salonId, status, createdAt])
  @@map("queue_closing_requests")
}

model QueueConflictAlert {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId     String    @map("entry_id") @db.Uuid
  originalTime DateTime? @map("original_time") @db.Timestamptz(6)
  shiftedTime DateTime? @map("shifted_time") @db.Timestamptz(6)
  reason      String
  status      String    @default("OPEN") @db.VarChar(20)
  resolution  String?   @db.VarChar(20)
  resolvedByAccountId String? @map("resolved_by_account_id") @db.Uuid
  resolutionNotes String? @map("resolution_notes")
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("queue_conflict_alerts")
}
