model PosBillingSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId           String    @map("salon_id") @db.Uuid
  customerAccountId String    @map("customer_account_id") @db.Uuid
  bookingId         String?   @map("booking_id") @db.Uuid
  bookingGroupId    String?   @map("booking_group_id") @db.Uuid
  queueEntryId      String?   @map("queue_entry_id") @db.Uuid
  origin            String    @default("QUEUE") @db.VarChar(20)
  status            String    @default("OPEN") @db.VarChar(20)
  sessionTotal      Decimal   @default(0) @map("session_total") @db.Decimal(12, 2)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@index([customerAccountId, createdAt])
  @@map("pos_billing_sessions")
}

model PosBill {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId          String    @map("session_id") @db.Uuid
  salonId            String    @map("salon_id") @db.Uuid
  invoiceNumber      String    @unique @map("invoice_number") @db.VarChar(100)
  billType           String    @default("SERVICE") @map("bill_type") @db.VarChar(20)
  offerPurchaseRequestId String? @map("offer_purchase_request_id") @db.Uuid
  workflowStatus     String    @default("DRAFT") @map("workflow_status") @db.VarChar(20)
  currentVersion     Int       @default(0) @map("current_version")
  confirmedByAccountId String? @map("confirmed_by_account_id") @db.Uuid
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  refundWindowDays   Int       @default(7) @map("refund_window_days")
  subtotal           Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  serviceTaxAmount   Decimal   @default(0) @map("service_tax_amount") @db.Decimal(12, 2)
  productTaxAmount   Decimal   @default(0) @map("product_tax_amount") @db.Decimal(12, 2)
  offerTaxAmount     Decimal   @default(0) @map("offer_tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal   @map("total_amount") @db.Decimal(12, 2)
  status             String    @default("OPEN") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)

  @@unique([id, salonId])
  @@index([sessionId])
  @@map("pos_bills")
}

