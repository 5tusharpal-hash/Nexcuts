{
  "name": "salonix",
  "version": "1.0.0",
  "description": "This is the root directory for the Salonix project.",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "inventory:reminders": "tsx src/modules/inventory/inventory-reminders.job.ts",
    "build": "pnpm db:generate && pnpm typecheck && pnpm exec tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/config/env.spec.ts src/bootstrap/app.spec.ts src/modules/auth/auth.validation.spec.ts src/modules/auth/auth-otp.service.spec.ts src/modules/tenancy/tenancy.validation.spec.ts src/modules/admin/admin.validation.spec.ts src/modules/services/services.validation.spec.ts src/modules/reviews/reviews.validation.spec.ts src/modules/analytics/analytics.validation.spec.ts src/modules/customer_ledger/customer_ledger.validation.spec.ts src/modules/enquiries/enquiries.validation.spec.ts src/modules/discovery/discovery.validation.spec.ts src/modules/notifications/notifications.validation.spec.ts src/modules/employee_management/employee_management.validation.spec.ts src/modules/loyalty/loyalty.calculations.spec.ts src/modules/pos_billing/salon_tax_rates.validation.spec.ts src/modules/pos_billing/pos_billing.refunds.validation.spec.ts src/modules/platform_billing/platform_billing.service.spec.ts src/modules/marketing/marketing.validation.spec.ts src/modules/queue/queue-scheduling.spec.ts src/modules/booking/customer-reservation.rules.spec.ts src/integrations/object-storage/image-processing.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --config .oxlintrc.json src",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.2.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.5.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "redis": "^6.3.0",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
