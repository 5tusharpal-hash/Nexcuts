# --- SERVER CONFIGURATION ---
# Environment: development | production | test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# --- DATABASE CONFIGURATION ---
# Runtime connection. Use Neon's pooled URL for application requests.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salonix?schema=public"
# Prisma migration connection. Use Neon's direct, non-pooled URL.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salonix?schema=public"


# --- INFRASTRUCTURE CONFIGURATION ---
# Redis Connection String
REDIS_URL="redis://localhost:6379"

# --- PRIVATE MEDIA STORAGE ---
# Configure the private bucket name. Neon supplies the branch-specific AWS_* values
# when using Neon Object Storage. MEDIA_STORAGE_* values override those defaults.
# For Cloudflare R2, set endpoint, region ("auto"), and credentials in MEDIA_STORAGE_*.
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=

# --- AUTHENTICATION ---
# Use mock delivery locally. Development OTPs are shown in API responses.
AUTH_OTP_DELIVERY=mock
AUTH_OTP_EXPOSE_OTP=true
# Set a separate random secret in production.
AUTH_OTP_HASH_SECRET="replace_with_a_different_random_secret_of_at_least_32_chars"

# Google Sign-In OAuth web client ID. Required to enable Google login.
GOOGLE_CLIENT_ID=

# Production WhatsApp Business Cloud API authentication template.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=
META_WHATSAPP_OTP_TEMPLATE=
META_WHATSAPP_OTP_LANGUAGE=en
# Must be an approved Meta template with one body text parameter for the campaign body.
META_WHATSAPP_MARKETING_TEMPLATE=
META_WHATSAPP_MARKETING_LANGUAGE=en

# Production email verification and password-reset delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ElasticSearch Connection String
ELASTICSEARCH_URL="http://localhost:9200"

# --- PLATFORM BILLING PROVIDERS ---
# Enable a provider by configuring its API credentials and webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Browser return destination after hosted checkout. No card data is handled by Salonix.
PLATFORM_BILLING_RETURN_URL=http://localhost:3000/platform-billing/return

# Example: Mail Service (AWS SES / SendGrid)
MAIL_API_KEY="your_mail_api_key"
MAIL_FROM_ADDRESS="noreply@salonix.com"

# --- SECURITY ---
# Access tokens last 15 minutes. Refresh cookies rotate with a 30-day idle TTL,
# bounded by a 90-day session lifetime.
JWT_SECRET="replace_with_at_least_32_random_characters"
AUTH_COOKIE_NAME=salonix_refresh_token
# Leave blank for a host-only API cookie, which is the recommended default.
# Only set this when your deployment requires sharing the cookie across subdomains.
# AUTH_COOKIE_DOMAIN=.salonix.com
AUTH_COOKIE_DOMAIN=
